    && test "${#BASE_SOURCE_REVISION}" -eq 40 \
    && test "${#CANDIDATE_DOCKERFILE_SHA256}" -eq 64
LABEL org.opencontainers.image.revision="$BASE_SOURCE_REVISION" \
      org.opencontainers.image.base.digest="sha256:9249261993db977032af3b0ff7369af07ea13216f61d77b30a243ccb2b2ffc04" \
