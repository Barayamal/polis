RUN apt-get update \
    && apt-get install --no-install-recommends --only-upgrade -y libc6=2.39-0ubuntu8.9 libc-bin=2.39-0ubuntu8.9 \
    && test "$(dpkg-query -W -f='${Version}' libc6)" = 2.39-0ubuntu8.9 \
    && test "$(dpkg-query -W -f='${Version}' libc-bin)" = 2.39-0ubuntu8.9 \
    && test -f /usr/local/bin/gosu \
    && rm /usr/local/bin/gosu \
    && test ! -e /usr/local/bin/gosu \
