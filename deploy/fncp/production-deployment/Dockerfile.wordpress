# syntax=docker.io/docker/dockerfile:1.4@sha256:9ba7531bd80fb0a858632727cf7a112fbfd19b17e94c4e84ced81e24ef1a0dbc
FROM docker.io/library/node:24.18.1-alpine@sha256:f70403e87646dc51b45295f4b8b70cdad0b63d2297c4c9899119b03f7af7a6b3 AS busybox-fixed
RUN apk add --no-cache build-base=0.5-r4 curl=8.22.0-r0 file=5.47-r2 linux-headers=7.0.0-r1 patch=2.8-r0 pkgconf=2.5.1-r0 utmps-dev=0.1.3.3-r0 utmps-static=0.1.3.3-r0
COPY server/busybox-fixed /opt/fncp-busybox-fix
RUN chmod 0555 /opt/fncp-busybox-fix/build-fixed-busybox.sh && /opt/fncp-busybox-fix/build-fixed-busybox.sh
COPY deploy/fncp/production-security/zlib-fixed /opt/fncp-zlib-fix
RUN chmod 0555 /opt/fncp-zlib-fix/build-fixed-zlib.sh && /opt/fncp-zlib-fix/build-fixed-zlib.sh
# Immutable upstream WordPress source only; none of its Debian runtime crosses.
FROM docker.io/library/wordpress@sha256:ab6fc9ad816c305305905694238e5566a39e8d1c56719741e359605a89f15bf6 AS wordpress-source
FROM docker.io/library/alpine@sha256:e7a1a92a5bfeee40966aea60f0796b0e7917cc35591542701834f03a68fa3d18
RUN apk add --no-cache \
      apache2=2.4.68-r0 apache2-ssl=2.4.68-r0 \
      php83=8.3.33-r0 php83-apache2=8.3.33-r0 php83-common=8.3.33-r0 \
      php83-mysqli=8.3.33-r0 php83-mysqlnd=8.3.33-r0 php83-openssl=8.3.33-r0 \
      php83-curl=8.3.33-r0 php83-dom=8.3.33-r0 php83-xml=8.3.33-r0 \
      php83-mbstring=8.3.33-r0 php83-session=8.3.33-r0 php83-ctype=8.3.33-r0 \
      php83-fileinfo=8.3.33-r0 php83-iconv=8.3.33-r0 php83-tokenizer=8.3.33-r0 \
      php83-sodium=8.3.33-r0 php83-posix=8.3.33-r0 php83-simplexml=8.3.33-r0 \
      php83-xmlreader=8.3.33-r0 php83-xmlwriter=8.3.33-r0 \
      libcrypto3=3.5.8-r0 libssl3=3.5.8-r0 ca-certificates=20260909-r0 \
    && addgroup -S -g 33 fncp-wordpress \
    && adduser -S -D -H -u 33 -G fncp-wordpress -s /sbin/nologin fncp-wordpress \
    && ln -s /usr/bin/php83 /usr/local/bin/php
# Copy after every apk operation so the fixed binary cannot be overwritten.
COPY --from=busybox-fixed /out/busybox /bin/busybox
COPY --from=busybox-fixed /out/zlib/lib/libz.so.1.3.2 /lib/libz.so.1.3.2
COPY --from=busybox-fixed /out/zlib/evidence/provenance.txt /usr/share/fncp-security/zlib-provenance.txt
COPY --from=wordpress-source /usr/src/wordpress /usr/src/wordpress
COPY deploy/fncp/production-deployment/wordpress-runtime/apache-alpine.conf /etc/apache2/httpd.conf
COPY deploy/fncp/production-deployment/wordpress-runtime/apache.conf /etc/apache2/fncp-vhost.conf
COPY deploy/fncp/production-deployment/wordpress-runtime/php-runtime.ini /etc/php83/conf.d/99-fncp.ini
COPY deploy/fncp/production-deployment/wordpress-runtime/wp-config.php /usr/src/wordpress/wp-config.php
COPY deploy/fncp/production-deployment/wordpress-runtime/mu-loader.php /usr/src/wordpress/wp-content/mu-plugins/fncp-loader.php
COPY deploy/fncp/production-wordpress/contract.php deploy/fncp/production-wordpress/store.php deploy/fncp/production-wordpress/fncp-production-wordpress.php /usr/src/wordpress/wp-content/mu-plugins/fncp-production/
COPY deploy/fncp/production-deployment/wordpress-runtime/material.php deploy/fncp/production-deployment/wordpress-runtime/preflight.php /opt/fncp-wordpress/
COPY --chmod=0555 deploy/fncp/production-deployment/wordpress-runtime/start.sh /usr/local/bin/fncp-wordpress-start
COPY --chmod=0555 deploy/fncp/production-deployment/wordpress-runtime/apache2-foreground /usr/local/bin/apache2-foreground
RUN php -r 'foreach (["mysqli","openssl","curl","dom","xml","mbstring","session","ctype","fileinfo","iconv","tokenizer","sodium","posix","SimpleXML","xmlreader","xmlwriter","filter","zlib"] as $e) { if (!extension_loaded($e)) exit(1); } if (PHP_VERSION !== "8.3.33") exit(1);' \
    && test -f /usr/lib/apache2/mod_php83.so \
    && test -f /usr/lib/apache2/mod_ssl.so \
    && test "$(id -u fncp-wordpress)" = 33 \
    && for package in ghostscript imagemagick tiff; do ! apk info -e "$package"; done \
    && find /usr/src/wordpress -type d -exec chmod 0755 '{}' + \
    && find /usr/src/wordpress -type f -exec chmod 0644 '{}' +
RUN test "$(sha256sum /lib/libz.so.1.3.2 | awk '{print $1}')" = "$(sed -n 's/^binary_sha256=//p' /usr/share/fncp-security/zlib-provenance.txt)"
WORKDIR /usr/src/wordpress
USER 33:33
ENTRYPOINT ["/usr/local/bin/fncp-wordpress-start"]
ARG SOURCE_REVISION
RUN php -r 'if (preg_match("/\\A[a-f0-9]{40}\\z/D", $argv[1]) !== 1) exit(1);' "$SOURCE_REVISION"
LABEL org.opencontainers.image.revision="$SOURCE_REVISION" org.barayamal.fncp.busybox.remediation="CVE-2025-60876-upstream-patch" org.barayamal.fncp.zlib.remediation="CVE-2026-85091-df84af25dc1942490e1d1c899a07619152a46148" org.barayamal.fncp.profile="FNCP_WORDPRESS_RUNTIME_V1"
