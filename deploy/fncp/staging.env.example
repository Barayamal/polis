# Disposable First Nations Community Pulse Pol.is staging only.
# Copy to .env.staging with ./deploy/fncp/prepare-staging.sh.
# Never use these example values or the local OIDC simulator in production.

COMPOSE_PROJECT_NAME=fncp-polis-staging
TAG=fncp-staging
GIT_HASH=424dcae02f0147723a19103dd2d971f6ec1b6db5
# prepare-staging.sh replaces this with the exact local source commit. It is
# used only as immutable image provenance, never as a deployment selector.
FNCP_SOURCE_REVISION=REPLACE_WITH_SOURCE_REVISION

DEV_MODE=false
ENABLE_TELEMETRY=false
MATH_ENV=dev
MATH_LOG_LEVEL=warn
SERVER_LOG_LEVEL=warn
SERVER_LOG_TO_FILE=false
SERVER_RUNTIME_UID=REPLACE_WITH_LOCAL_UID
SERVER_RUNTIME_GID=REPLACE_WITH_LOCAL_GID
CACHE_MATH_RESULTS=true
RUN_PERIODIC_EXPORT_TESTS=false
SHOULD_USE_TRANSLATION_API=false

POSTGRES_DB=fncp_polis_staging
POSTGRES_HOST=postgres:5432
POSTGRES_PORT=5432
POSTGRES_USER=fncp_polis
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_VALUE
DATABASE_URL=postgres://fncp_polis:REPLACE_WITH_RANDOM_VALUE@postgres:5432/fncp_polis_staging
DATABASE_SSL=false
READ_ONLY_DATABASE_URL=

API_SERVER_PORT=5000
API_DEV_HOSTNAME=localhost
API_PROD_HOSTNAME=localhost
DOMAIN_OVERRIDE=localhost
EMBED_SERVICE_HOSTNAME=localhost
SERVICE_URL=http://localhost:8088
# The minimal FNCP path uses the alpha SSR service for participant assets.
# Admin, legacy participant and report bundles are deliberately not built.
STATIC_FILES_HOST=client-participation-alpha
STATIC_FILES_PORT=4321
STATIC_FILES_ADMIN_PORT=4321
STATIC_FILES_PARTICIPATION_PORT=4321
PUBLIC_SERVICE_URL=http://localhost:8088/api/v3
INTERNAL_SERVICE_URL=http://server:5000/api/v3
DOMAIN_WHITELIST_ITEM_01=localhost
DOMAIN_WHITELIST_ITEM_02=localhost:8088
DOMAIN_WHITELIST_ITEM_03=
DOMAIN_WHITELIST_ITEM_04=
DOMAIN_WHITELIST_ITEM_05=
DOMAIN_WHITELIST_ITEM_06=
DOMAIN_WHITELIST_ITEM_07=
DOMAIN_WHITELIST_ITEM_08=

AUTH_AUDIENCE=users
AUTH_CLIENT_ID=fncp-local-admin
AUTH_CLIENT_SECRET=REPLACE_WITH_RANDOM_VALUE
AUTH_DOMAIN=localhost:3000
AUTH_ISSUER=https://oidc-simulator:3000/
AUTH_NAMESPACE=https://pulse.barayamal.com.au/polis/
AUTH_SIMULATOR_PORT=3000
JWKS_URI=https://oidc-simulator:3000/.well-known/jwks.json
OIDC_CACHE_KEY_ID_TOKEN_SUFFIX=@@user@@
OIDC_CACHE_KEY_PREFIX=fncp.polis.user
ADMIN_UIDS=[]

POLIS_JWT_AUDIENCE=fncp-participants
POLIS_JWT_ISSUER=http://localhost:8088/
JWT_PRIVATE_KEY_PATH=/app/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt-public.pem
LOGIN_CODE_PEPPER=REPLACE_WITH_RANDOM_VALUE
ENCRYPTION_PASSWORD_00001=REPLACE_WITH_RANDOM_VALUE

ADMIN_EMAIL_DATA_EXPORT_TEST=
ADMIN_EMAIL_DATA_EXPORT=
ADMIN_EMAIL_EMAIL_TEST=
ADMIN_EMAILS=[]
POLIS_FROM_ADDRESS="FNCP staging <noreply@invalid.example>"
SES_ENDPOINT=
EMAIL_TRANSPORT_TYPES=

AKISMET_ANTISPAM_API_KEY=
GA_TRACKING_ID=
GOOGLE_CREDENTIALS_BASE64=
GOOGLE_CREDS_STRINGIFIED=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_LOCAL_ENDPOINT=
SQS_QUEUE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
MAX_REPORT_CACHE_DURATION=
DYNAMODB_ENDPOINT=
AWS_S3_ENDPOINT=
AWS_S3_BUCKET_NAME=
OLLAMA_HOST=
OLLAMA_MODEL=

WEBSERVER_USERNAME=fncp-math
WEBSERVER_PASS=REPLACE_WITH_RANDOM_VALUE
TOPICAL_COMMENT_RATIO=0.6
# Private-origin gateway enforcement stays off for the baseline build/smoke
# test. Enable only after the gateway and its exact synthetic conversation are
# configured together.
FNCP_GATEWAY_ENFORCEMENT=false
FNCP_GATEWAY_CONVERSATION_ID=
FNCP_GATEWAY_SHARED_SECRET=
