{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barayamal.com.au/schemas/fncp/busybox-vex-input-v1.json",
  "title": "First Nations Community Pulse BusyBox VEX evidence input",
  "description": "Strict, architecture-bound source data for a single exact-image BusyBox OpenVEX statement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "document",
    "subject",
    "busybox",
    "patch",
    "vulnerability"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "role",
        "timestamp",
        "version"
      ],
      "properties": {
        "author": {
          "const": "https://barayamal.com.au/"
        },
        "role": {
          "const": "Document Creator"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "reference",
        "mediaType",
        "manifestDigest",
        "indexDigest",
        "platform"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "reference": {
          "type": "string",
          "minLength": 75
        },
        "mediaType": {
          "enum": [
            "application/vnd.oci.image.manifest.v1+json",
            "application/vnd.docker.distribution.manifest.v2+json"
          ]
        },
        "manifestDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "indexDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "architecture"
          ],
          "properties": {
            "os": {
              "const": "linux"
            },
            "architecture": {
              "enum": [
                "amd64",
                "arm64"
              ]
            },
            "variant": {
              "type": "string",
              "pattern": "^v[0-9]+$"
            }
          }
        }
      }
    },
    "busybox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "/bin/busybox"
        },
        "version": {
          "const": "1.37.0"
        },
        "sha256": {
          "$ref": "#/$defs/sha256Hex"
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "const": "CVE-2025-60876.patch"
        },
        "sha256": {
          "$ref": "#/$defs/sha256Hex"
        }
      }
    },
    "vulnerability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "justification"
      ],
      "properties": {
        "id": {
          "const": "CVE-2025-60876"
        },
        "status": {
          "const": "not_affected"
        },
        "justification": {
          "const": "vulnerable_code_not_present"
        }
      }
    }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
