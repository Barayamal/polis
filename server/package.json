    "@aws-sdk/client-sesv2": "3.1096.0",
    "@aws-sdk/client-sqs": "3.1096.0",
    "@aws-sdk/lib-dynamodb": "3.1096.0",
    "@aws-sdk/s3-request-presigner": "3.1096.0",
    "@google-cloud/translate": "9.4.2",
    "@google/genai": "2.13.0",
