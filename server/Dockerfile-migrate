FROM docker.io/library/node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS fncp-busybox-fixed

RUN apk add --no-cache \
  build-base=0.5-r4 \
  curl=8.21.0-r0 \
  file=5.47-r2 \
  linux-headers=7.0.0-r1 \
  patch=2.8-r0 \
  pkgconf=2.5.1-r0 \
  utmps-dev=0.1.3.3-r0 \
  utmps-static=0.1.3.3-r0
COPY busybox-fixed /opt/fncp-busybox-fix
RUN chmod 0555 /opt/fncp-busybox-fix/build-fixed-busybox.sh \
  && /opt/fncp-busybox-fix/build-fixed-busybox.sh

FROM docker.io/library/postgres:17-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193

ARG SOURCE_REVISION
LABEL org.barayamal.fncp.artifact="polis-migration" \
      org.barayamal.fncp.lifecycle="short-lived" \
      org.barayamal.fncp.release-scope="production" \
      org.barayamal.fncp.busybox.remediation="CVE-2025-60876-upstream-patch" \
      org.opencontainers.image.base.digest="sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193" \
      org.opencontainers.image.base.name="docker.io/library/postgres:17-alpine" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/Barayamal/polis"

COPY --from=fncp-busybox-fixed /out/busybox /bin/busybox
RUN set -eu; \
  test "$(readlink -f /bin/sh)" = /bin/busybox; \
  test "$(readlink -f /usr/bin/wget)" = /bin/busybox; \
  bad_url="$(printf 'http://127.0.0.1/%b' '\rX-FNCP: injected')"; \
  if /usr/bin/wget "$bad_url" >/tmp/wget.stdout 2>/tmp/wget.stderr; then exit 1; fi; \
  grep -Fq 'Unencoded control character found in the URL!' /tmp/wget.stderr; \
  rm -f /tmp/wget.stdout /tmp/wget.stderr
COPY --chown=postgres:postgres ./bin/fncp-run-migrations.sh /usr/local/bin/fncp-run-migrations
COPY --chown=postgres:postgres ./postgres/migrations/*.sql /opt/fncp/migrations/

# The release task needs only the libpq client. Remove database-server and
# lifecycle utilities so this image cannot initialize or host PostgreSQL.
RUN chmod 0555 /usr/local/bin/fncp-run-migrations && \
    chmod 0444 /opt/fncp/migrations/*.sql && \
    test "${#SOURCE_REVISION}" -eq 40 && \
    case "$SOURCE_REVISION" in *[!0-9a-f]*) exit 1;; esac && \
    rm -f \
      /usr/local/bin/clusterdb \
      /usr/local/bin/createdb \
      /usr/local/bin/createuser \
      /usr/local/bin/docker-enforce-initdb.sh \
      /usr/local/bin/docker-ensure-initdb.sh \
      /usr/local/bin/docker-entrypoint.sh \
      /usr/local/bin/dropdb \
      /usr/local/bin/dropuser \
      /usr/local/bin/ecpg \
      /usr/local/bin/gosu \
      /usr/local/bin/initdb \
      /usr/local/bin/oid2name \
      /usr/local/bin/pg_amcheck \
      /usr/local/bin/pg_archivecleanup \
      /usr/local/bin/pg_basebackup \
      /usr/local/bin/pgbench \
      /usr/local/bin/pg_checksums \
      /usr/local/bin/pg_combinebackup \
      /usr/local/bin/pg_config \
      /usr/local/bin/pg_controldata \
      /usr/local/bin/pg_createsubscriber \
      /usr/local/bin/pg_ctl \
      /usr/local/bin/pg_dump \
      /usr/local/bin/pg_dumpall \
      /usr/local/bin/pg_isready \
      /usr/local/bin/pg_receivewal \
      /usr/local/bin/pg_recvlogical \
      /usr/local/bin/pg_resetwal \
      /usr/local/bin/pg_restore \
      /usr/local/bin/pg_rewind \
      /usr/local/bin/pg_test_fsync \
      /usr/local/bin/pg_test_timing \
      /usr/local/bin/pg_upgrade \
      /usr/local/bin/pg_verifybackup \
      /usr/local/bin/pg_waldump \
      /usr/local/bin/pg_walsummary \
      /usr/local/bin/postmaster \
      /usr/local/bin/postgres \
      /usr/local/bin/reindexdb \
      /usr/local/bin/vacuumdb \
      /usr/local/bin/vacuumlo && \
    rm -rf /docker-entrypoint-initdb.d && \
    test -x /usr/local/bin/psql && \
    test "$(find /opt/fncp/migrations -mindepth 1 -maxdepth 1 -type f -name '*.sql' | wc -l | tr -d ' ')" -gt 0 && \
    test -z "$(find /opt/fncp/migrations -mindepth 2 -print -quit)"

USER postgres
WORKDIR /opt/fncp

STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/fncp-run-migrations"]
CMD []
